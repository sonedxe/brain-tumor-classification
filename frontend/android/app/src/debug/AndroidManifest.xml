<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- El backend de desarrollo corre en HTTP sin TLS, y Android 9+ bloquea el
         trafico en claro por defecto. Se habilita solo en la variante debug y
         solo para los hosts de la maquina de desarrollo, nunca en release.
         Ver res/xml/network_security_config.xml. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"/>
</manifest>
