# Copiar como .env en la raiz del repositorio.
# El backend (backend/app/core/config.py) lee este archivo automaticamente.

APP_NAME="Brain Tumor Classification API"
API_V1_PREFIX=/api/v1

# Ruta a los pesos entrenados. Debe existir ml/models/<modelo>/best.pt
MODEL_PATH=ml/models/mobilenetv3/best.pt
MODEL_VERSION=mobilenetv3-v1
IMAGE_SIZE=256

# Si es true, /predict devuelve una respuesta ficticia mientras el modelo
# real no este implementado. Poner en false cuando haya pesos entrenados.
MOCK_INFERENCE=true

DATABASE_URL=sqlite:///./db.sqlite3
MAX_UPLOAD_BYTES=10485760

# Origenes permitidos por CORS (frontend en desarrollo)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
